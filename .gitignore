# Share the Stripe Projects manifest; keep vaults and machine state local
/.projects/*
!/.projects/state.json
!/.projects/state.local.json
/.claude/

# Share reviewed Stripe CLI instructions; keep other agent/editor tooling local
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/stripe-projects-cli/
/.cursor/*
!/.cursor/rules/
/.cursor/rules/*
!/.cursor/rules/stripe-projects-cli.mdc

# Private presentation notes
/docs/demo.md

# Generated model responses, experiment code, and run logs
/experiments/

# Local secrets (never store credentials in source files)
/.secrets/

# Python dependencies and caches
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/

# JavaScript dependencies and generated builds
node_modules/
/.next/
/.next-production/
/dist/
/coverage/
*.log

# OS/editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo

# Local application records and verification evidence
/data/
/artifacts/
*.tsbuildinfo

# Local credentials; only the empty setup template is public

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example
