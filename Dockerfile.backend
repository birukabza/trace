FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY backend ./backend
COPY src/lib ./src/lib
RUN npm run build:backend

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=4000 TRACE_DATA_DIR=/data
WORKDIR /app
COPY package.json package-lock.json ./
RUN apt-get update && apt-get install -y --no-install-recommends gosu ca-certificates && rm -rf /var/lib/apt/lists/* \
    && npm ci --omit=dev && npm cache clean --force && mkdir /data && chown node:node /data
COPY --from=build /app/dist/backend ./dist/backend
COPY --chmod=755 backend/entrypoint.sh /usr/local/bin/trace-entrypoint
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["trace-entrypoint"]
CMD ["node", "dist/backend/server.mjs"]
