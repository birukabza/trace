# Copy to .env.local for development. Never commit .env.local or real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RIVER_API_KEY=
CREATEOS_SANDBOX_ID=

# Server-only connection from Next.js to the long-running backend.
TRACE_BACKEND_URL=http://127.0.0.1:4000
FRONTEND_URL=http://localhost:3000

# Stripe Projects writes CreateOS credentials to its generated .env file:
# stripe projects env --pull
# Do not add a blank CREATEOS_PROJECT_API_KEY here: it would override that file.
# On Railway, set CREATEOS_PROJECT_API_KEY in service variables instead.
# Railway also needs TRACE_DATA_DIR=/data and a persistent volume at /data.
# Production variables and deployment steps are documented in README.md.
